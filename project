        function addAtom(symbol) {
            currentAtoms.push(symbol);
            updateWorkbench();
        }

        function clearWorkbench() {
            currentAtoms = [];
            updateWorkbench();
            resetProperties();
        }

        function updateWorkbench() {
            const wb = document.getElementById('workbench');
            if (currentAtoms.length === 0) {
                wb.innerHTML = '<span style="color: #64748b;">Робоча зона порожня...</span>';
                return;
            }
            wb.innerHTML = currentAtoms.map(a => `<div class="atom-ball atom-${a}">${a}</div>`).join('');
        }

        function loadPreset(atomsArray) {
            currentAtoms = [...atomsArray];
            updateWorkbench();
            checkSubstance();
        }

        function checkSubstance() {
            const exactKey = currentAtoms.join('-');
            const info = substances[exactKey];

            const infoTitle = document.getElementById('substance-info');
            const propDisplay = document.getElementById('properties-display');

            if (info) {
                infoTitle.innerText = info.name;
                propDisplay.innerHTML = `
                    <div class="prop-row"><span class="prop-name">Хімічна формула:</span> <span class="prop-val">${info.formula}</span></div>
                    <div class="prop-row"><span class="prop-name">Агрегатний стан:</span> <span class="prop-val">${info.state}</span></div>
                    <div class="prop-row"><span class="prop-name">Структура та будова:</span> <span class="prop-val">${info.structure}</span></div>
                    <div class="prop-row"><span class="prop-name">Розчинність у воді:</span> <span class="prop-val">${info.solubility}</span></div>
                    <div class="prop-row"><span class="prop-name">Шкільне дослідження / Факт:</span> <span class="prop-val" style="color: var(--accent);">${info.notes}</span></div>
                `;
            } else {
                infoTitle.innerText = "Невідома або хибна структура";
                propDisplay.innerHTML = `
                    <div class="prop-row"><span class="prop-name">Порядок в зоні:</span> <span class="prop-val">${currentAtoms.join(' - ')}</span></div>
                    <div class="prop-row"><span class="prop-name">Результат:</span> <span class="prop-val" style="color: #ef4444;">У такому порядку атоми не утворюють стабільну молекулу за програмою 5 класу</span></div>
                `;
            }
        }

        function resetProperties() {
            document.getElementById('substance-info').innerText = "Оберіть або зберіть речовину";
            document.getElementById('properties-display').innerHTML = `
                <div class="prop-row"><span class="prop-name">Хімічна формула:</span> <span class="prop-val">—</span></div>
                <div class="prop-row"><span class="prop-name">Агрегатний стан:</span> <span class="prop-val">—</span></div>
                <div class="prop-row"><span class="prop-name">Структура та будова:</span> <span class="prop-val">—</span></div>
                <div class="prop-row"><span class="prop-name">Розчинність у воді:</span> <span class="prop-val">—</span></div>
                <div class="prop-row"><span class="prop-name">Шкільне дослідження / Факт:</span> <span class="prop-val">—</span></div>
            `;
        }
    </script>
