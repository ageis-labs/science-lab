                    <span style="display:flex; gap:4px; align-items:center;">
                        <span class="atom-ball atom-H" style="width:16px;height:16px;font-size:0.5rem;">H</span>
                        <span class="atom-ball atom-H" style="width:16px;height:16px;font-size:0.5rem;">H</span>
                    </span>
                </div>
                <div class="preset-item" onclick="loadPreset(['H', 'O', 'H'])">
                    <span>Вода (H₂O)</span>
