            <div class="atom-grid">
                <button type="button" class="atom-btn" onclick="addAtom('H')">H (Водень)</button>
                <button type="button" class="atom-btn" onclick="addAtom('O')">O (Кисень)</button>
                <button type="button" class="atom-btn" onclick="addAtom('N')">N (Азот)</button>
                <button type="button" class="atom-btn" onclick="addAtom('C')">C (Вуглець)</button>
                <button type="button" class="atom-btn" onclick="addAtom('S')">S (Сера)</button>
                <button type="button" class="atom-btn" onclick="addAtom('P')">P (Фосфор)</button>
                <button type="button" class="atom-btn" onclick="addAtom('Cl')">Cl (Хлор)</button>
                <button type="button" class="atom-btn" onclick="addAtom('Fe')">Fe (Залізо)</button>
                <button type="button" class="atom-btn" onclick="addAtom('Na')">Na (Натрій)</button>
                <button type="button" class="atom-btn" onclick="addAtom('Ca')">Ca (Кальцій)</button>
            </div>

            <div class="workbench" id="workbench">
                <span style="color: #64748b;">Робоча зона порожня...</span>
            </div>

            <div class="btn-group">
                <button type="button" class="action-btn" onclick="checkSubstance()">Дослідити речовину</button>
                <button type="button" class="action-btn clear-btn" onclick="clearWorkbench()">Скинути</button>
            </div>

            <h3 style="font-size: 0.95rem; margin-top: 18px; margin-bottom: 8px; color: #cbd5e1;">Готові молекули (швидкий вибір):</h3>
            <div class="preset-list">
                <div class="preset-item" onclick="loadPreset(['N', 'N'])">
                    <span>Азот (N₂)</span>
                    <span style="display:flex; gap:4px; align-items:center;">
                        <span class="atom-ball atom-N" style="width:18px;height:18px;font-size:0.55rem;">N</span>
                        <span class="atom-ball atom-N" style="width:18px;height:18px;font-size:0.55rem;">N</span>
