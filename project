                        <span class="atom-ball atom-O" style="width:16px;height:16px;font-size:0.5rem;">O</span>
                        <span class="atom-ball atom-O" style="width:16px;height:16px;font-size:0.5rem;">O</span>
                        <span class="atom-ball atom-O" style="width:16px;height:16px;font-size:0.5rem;">O</span>
                    </span>
                </div>
