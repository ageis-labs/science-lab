                        <span class="atom-ball atom-H" style="width:16px;height:16px;font-size:0.5rem;">H</span>
                        <span class="atom-ball atom-O" style="width:18px;height:18px;font-size:0.55rem;">O</span>
                        <span class="atom-ball atom-H" style="width:16px;height:16px;font-size:0.5rem;">H</span>
                    </span>
                </div>
                <div class="preset-item" onclick="loadPreset(['H', 'O', 'O', 'H'])">
